# Diet Tracker 环境变量模板
# 把这个文件复制为 .env，再填入真实值。.env 已在 .gitignore 中，不会进版本库。

# 后端端口
PORT=3000

# ===== LLM 模型 A（必填一个） =====
# 任意 OpenAI 兼容的 /chat/completions 接口都可以
LLM_A_API_KEY=sk-...
LLM_A_BASE_URL=https://api.example.com/v1
LLM_A_MODEL=model-a

# ===== LLM 模型 B（可选，双模型对比时填） =====
LLM_B_API_KEY=sk-...
LLM_B_BASE_URL=https://api.example.com/v1
LLM_B_MODEL=model-b

# ===== LLM 模型 C（可选，A/B 分歧时的裁判模型） =====
LLM_C_API_KEY=sk-...
LLM_C_BASE_URL=https://api.example.com/v1
LLM_C_MODEL=model-c

# ===== 可选参数 =====
LLM_TIMEOUT_MS=30000
LLM_RATE_LIMIT_PER_SEC=10
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_MS=60000
PARSE_CACHE_SIZE=1000
PARSE_CACHE_TTL=3600000

# 裁判模型思考模式（enabled | disabled）
LLM_JUDGE_THINKING=enabled

# 校验层开关
L2_ENABLED=false
L4_ENABLED=false

# 日志文件名（可选）
LLM_READABLE_LOG_FILE=llm-readable.log
